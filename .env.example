# Gemini API key — create one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Models (override if your key has access to different ones). Free-tier quotas are per model
# and per day (e.g. 20 requests/day for gemini-3.5-flash), so the agent splits its calls:
CHAT_MODEL=gemini-3.5-flash          # writes answers
FAST_MODEL=gemini-3.5-flash-lite     # routing, grading, query rewrites
THINKING_LEVEL=minimal               # Gemini 3 thinking: minimal | low | medium | high
EMBEDDING_MODEL=gemini-embedding-001
# Changing this after ingesting requires `python -m scripts.init_db --reset` and re-ingesting.
EMBEDDING_DIM=768

# Matches docker-compose.yml
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
